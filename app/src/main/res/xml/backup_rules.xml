<?xml version="1.0" encoding="utf-8"?>
<!-- The Room DB stores SAF content:// URIs whose grants never survive a
     restore; excluding the database keeps auto-backup from resurrecting dead
     sound references. Users have the explicit JSON export/import instead. -->
<full-backup-content>
    <exclude domain="database" path="chanting.db" />
    <exclude domain="sharedpref" path="location.xml" />
</full-backup-content>
